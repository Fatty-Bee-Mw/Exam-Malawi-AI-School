# Frontend Environment Variables
# Copy this file to .env and set the values for your environment

# Development: Leave empty to use React dev server proxy (configured in package.json)
# Production: Set to your backend API URL (e.g., https://your-backend-url.com)
REACT_APP_API_BASE_URL=

# Netlify Functions URL (for production deployment on Netlify)
REACT_APP_TUTOR_FUNCTION_URL=/.netlify/functions/ask
